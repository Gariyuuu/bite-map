# ---------------------------------------------------------------------------
# Bite Map runs with ZERO of these set — mock restaurant data, a demo user,
# and a custom-projection map all work out of the box. Add keys below to
# upgrade each piece live, in any order, without touching app code.
# ---------------------------------------------------------------------------

# Database (Neon Postgres + Drizzle). Without this, restaurant browsing still
# works via the mock/live provider fallback, but visits/journal/wishlist/
# collections can't be saved.
DATABASE_URL=

# Auth (Clerk). Without these, the app runs in Demo Mode as the seeded
# "demo_user_you" account — see src/lib/auth.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Restaurant data providers — all optional and independent. See /src/providers
# for the adapters; searchAllProviders() fans out to whichever are configured
# and falls back to the mock dataset if none are.
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
# OpenStreetMap (via the public Overpass API) requires no key, but is a
# shared community resource — opt in explicitly to avoid hammering it.
ENABLE_OSM_PROVIDER=false

# Photo uploads (UploadThing). Without this, restaurant/journal photos fall
# back to seeded stock imagery.
UPLOADTHING_TOKEN=
NEXT_PUBLIC_UPLOADTHING_APP_ID=

# YUU AI food concierge — points at your self-hosted AI platform
# (~/Projects/ai-platform, api.gariyuuu.com). Without these, the AI Guide page
# shows a "connect YUU" message instead of live answers.
# YUU_API_URL is the base URL only (no /v1 suffix), e.g. https://api.gariyuuu.com
# YUU_API_KEY is a gai_live_... key: `docker compose exec api python -m admin create-key --name "bite-map"`
YUU_API_URL=
YUU_API_KEY=
# Optional — defaults to "Yuu no Sekai" (matches the gariyuuu-web chat demo)
YUU_MODEL=
